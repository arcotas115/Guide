# Copy to .env.local and fill in from your Supabase project
# (Dashboard -> Project Settings -> API Keys). .env.local is gitignored.
#
# Supabase's newer key format is what this project uses:
#   publishable key -> starts sb_publishable_  (safe for the browser; RLS gates it)
#   secret key      -> starts sb_secret_       (SERVER ONLY. bypasses RLS entirely)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Used ONLY by scripts/seed.ts, never imported into the Next.js app.
# If this ever appears in client code, treat it as a breach and rotate it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
